# EMOTIVA-MATH Backend Environment Variables

# Flask Configuration
SECRET_KEY=emotiva-math-secret-key-2024
FLASK_ENV=development
DEBUG=True

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=emotiva_math

# Optional: Full database URL (overrides individual settings)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/emotiva_math

# Google Gemini API Configuration (for LLM features)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (for Cloud File Storage)
# Files akan disimpan di Supabase bucket instead of local filesystem
# Get your credentials from: https://supabase.com
# 1. Create a project at https://app.supabase.com
# 2. Go to Project Settings > API
# 3. Copy the Project URL and Anon Key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key-here
SUPABASE_BUCKET_NAME=materials
USE_LLM=True
